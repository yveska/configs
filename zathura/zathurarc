# Options
set adjust-open "best-fit"
set pages-per-row 1
set scroll-page-aware "true"
set smooth-scroll "true"
set scroll-full-overlap 0.01
set scroll-step 100
set zoom-min 10
set guioptions ""

# Keybinds
unmap f
unmap i
map i recolor
map f toggle_fullscreen
map [fullscreen] f toggle_fullscreen

# Aesthetics
set font "inconsolata 12"
set default-bg          "#141617"
set default-fg          "#d1d8db"
set statusbar-bg        "#141617"
set statusbar-fg        "#d1d8db"
set inputbar-bg         "#141617"
set inputbar-fg         "#d1d8db"

set notification-warning-fg "#d4d230" 
set notification-warning-bg "#141617"

set completion-bg       "#141617"
set completion-fg       "#d1d8db"
set completion-highlight-bg "#DEEEED"
set completion-highlight-fg "#141617"

set highlight-color         "rgba(222, 238, 237, 0.3)"
set highlight-active-color  "rgba(222, 238, 237, 0.5)"

set completion-highlight-bg "#7a9aae" 
set completion-highlight-fg "#141617"

set recolor                 true
set recolor-lightcolor      "#141617"
set recolor-darkcolor       "#d1d8db"
set scroll-bar-color        "#141617"
